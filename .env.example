# Copy to .env and fill in. .env is gitignored — keep it that way.

# Where state/, control.json and torah.md live.
BLOB_ROOT=./run

# --- chain -------------------------------------------------------------
# Public endpoint is free and keyless, but shared and rate limited. Fine to
# prototype; swap in a provider before you poll every block. Only the URL changes.
RHC_RPC=https://rpc.mainnet.chain.robinhood.com
RHC_BLOCKSCOUT=https://robinhoodchain.blockscout.com/api

# Launch factory address, and the codehashes you accept as genuine deploys.
# token_audit treats an unrecognised codehash as a HARD FAIL, so an empty
# PONS_CODEHASHES means every token fails factory_origin. That is the correct
# default: fail closed, not open.
PONS_FACTORY=
PONS_CODEHASHES=

# --- solana ------------------------------------------------------------
# Public endpoint is keyless and heavily rate limited; it will drop you under
# real polling load. Swap in Helius / Triton / QuickNode before you depend on it.
SOL_RPC=https://api.mainnet-beta.solana.com

# Program ids are configurable for the same reason PONS_FACTORY is: a hardcoded
# address becomes a silent lie the moment the program migrates. These are the
# well-known mainnet defaults — VERIFY on an explorer before relying on them.
SOL_LAUNCH_PROGRAM=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P
SOL_AMM_PROGRAM=pAMMBay6oceH9fJKBRHGP5D4bD4sWpmSwMn52FMfXEA

# Fraction of supply moving in ONE transaction that counts as a whale.
SOL_WHALE_FRACTION=0.015

# Market-cap bands in SOL that emit mcap_cross. These define "early".
# Deliberately untuned — see torah.md §3. Yours will differ.
SOL_MCAP_BANDS=50,100,250,420,1000,2500

SOL_POLL_S=2.0

# --- telegram ----------------------------------------------------------
# A BOT token from @BotFather. Never a user session string: a bot token is
# revocable in one message, a session is your whole account.
TG_BOT_TOKEN=
TG_CHAT_ID=
